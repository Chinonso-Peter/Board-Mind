{
  "name": "boardmind-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @boardmind/ai-core build && pnpm --filter @boardmind/sync-server build && pnpm --filter @boardmind/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'Linting complete'",
    "start:sync": "pnpm --filter @boardmind/sync-server start",
    "start:web": "pnpm --filter @boardmind/web start",
    "dev:sync": "pnpm --filter @boardmind/sync-server dev",
    "dev:web": "pnpm --filter @boardmind/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.18.2",
    "better-sqlite3": "^13.1.1",
    "lib0": "^0.2.120",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "uuid": "^14.0.3",
    "vitest": "^2.1.6",
    "ws": "^8.22.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
